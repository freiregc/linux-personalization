# Normaliza fins de linha dos scripts e textos
* text=auto eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.dconf text eol=lf
*.txt text eol=lf

# Assets binários (evita diffs inúteis)
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text
data/fonts/** binary
data/icons/** binary
data/themes/** binary
data/wallpaper/** binary
*.ico filter=lfs diff=lfs merge=lfs -text
