[org/gnome/desktop/interface]
color-scheme='default'
enable-animations=true
gtk-theme='Orchis-Grey-Dark-Compact'
icon-theme='Colloid-Grey-Dark'
[org/gnome/mutter]
edge-tiling=false
[org/gnome/mutter/keybindings]
toggle-tiled-left=@as []
toggle-tiled-right=@as []
[org/gnome/shell]
app-picker-layout=[{'software-properties-drivers.desktop': <{'position': <0>}>, 'firmware-updater_firmware-updater.desktop': <{'position': <1>}>, 'org.gnome.eog.desktop': <{'position': <2>}>, 'org.gnome.clocks.desktop': <{'position': <3>}>, 'gnome-language-selector.desktop': <{'position': <4>}>, 'nvidia-settings.desktop': <{'position': <5>}>, 'org.gnome.PowerStats.desktop': <{'position': <6>}>, 'software-properties-gtk.desktop': <{'position': <7>}>, 'org.gnome.Calculator.desktop': <{'position': <8>}>, 'update-manager.desktop': <{'position': <9>}>, 'gnome-session-properties.desktop': <{'position': <10>}>, 'org.gnome.Settings.desktop': <{'position': <11>}>, 'org.gnome.SystemMonitor.desktop': <{'position': <12>}>, 'org.gnome.TextEditor.desktop': <{'position': <13>}>, 'org.gnome.Terminal.desktop': <{'position': <14>}>, 'Utilities': <{'position': <15>}>}]
disabled-extensions=['just-perfection-desktop@just-perfection', 'dash-in-panel@fthx']
enabled-extensions=['user-theme@gnome-shell-extensions.gcampax.github.com', 'ding@rastersoft.com', 'ubuntu-dock@ubuntu.com', 'tiling-assistant@ubuntu.com', 'dash-to-dock@micxgx.gmail.com', 'blur-my-shell@aunetx']
favorite-apps=['org.gnome.Nautilus.desktop', 'vivaldi-stable.desktop', 'code.desktop', 'whatsapp-desktop-linux_whatsapp-desktop-linux.desktop', 'discord.desktop']
[org/gnome/shell/extensions/blur-my-shell]
pipelines={'pipeline_default': {'name': <'Default'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_000000000000'>, 'params': <{'unscaled_radius': <100>, 'brightness': <0.46000000000000002>}>}>]>}, 'pipeline_default_rounded': {'name': <'Default rounded'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_000000000001'>, 'params': <{'unscaled_radius': <100>, 'brightness': <0.59999999999999998>}>}>]>}, 'pipeline_migrated_dynamic_blur': {'name': <'Migrated dynamic blur'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_migrated_dynamic_blur'>, 'params': <{'unscaled_radius': <60>, 'brightness': <0.59999999999999998>}>}>]>}, 'pipeline_liquid_glass': {'name': <'Liquid Glass'>, 'effects': <[<{'type': <'luminosity'>, 'id': <'effect_liquid_glass_luminosity'>, 'params': <{'saturation_multiplicator': <1.1000000000000001>}>}>, <{'type': <'refraction'>, 'id': <'effect_liquid_glass_refraction'>, 'params': <{'tint': <0>}>}>, <{'type': <'noise'>, 'id': <'effect_liquid_glass_noise'>, 'params': <{'noise': <0.10000000000000001>}>}>]>}, 'pipeline_vapor_glass': {'name': <'Vapor Glass'>, 'effects': <[<{'type': <'luminosity'>, 'id': <'effect_vapor_glass_luminosity'>, 'params': <{'saturation_multiplicator': <1.1000000000000001>}>}>, <{'type': <'wave'>, 'id': <'effect_vapor_glass_wave'>, 'params': <@a{sv} {}>}>, <{'type': <'refraction'>, 'id': <'effect_vapor_glass_refraction'>, 'params': <{'tint': <0>}>}>, <{'type': <'noise'>, 'id': <'effect_vapor_glass_noise'>, 'params': <{'noise': <0.10000000000000001>}>}>]>}, 'pipeline_classic_light_background': {'name': <'Classic Light Background'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_classic_light_blur'>, 'params': <{'unscaled_radius': <30>, 'brightness': <0.59999999999999998>}>}>, <{'type': <'color'>, 'id': <'effect_classic_light_color'>, 'params': <{'color': <(1.0, 1.0, 1.0, 0.25)>, 'blend_mode': <17>}>}>]>}, 'pipeline_classic_dark_background': {'name': <'Classic Dark Background'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_classic_dark_blur'>, 'params': <{'unscaled_radius': <30>, 'brightness': <0.59999999999999998>}>}>, <{'type': <'color'>, 'id': <'effect_classic_dark_color'>, 'params': <{'color': <(0.40000000000000002, 0.40000000000000002, 0.40000000000000002, 0.34999999999999998)>, 'blend_mode': <17>}>}>]>}, 'pipeline_default_light': {'name': <'Default (Light mode)'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_default_light_blur'>, 'params': <{'unscaled_radius': <30>, 'brightness': <1>}>}>, <{'type': <'color'>, 'id': <'effect_default_light_color'>, 'params': <{'color': <(1.0, 1.0, 1.0, 0.5)>, 'blend_mode': <3>}>}>]>}}
rounded-blur-found=false
settings-version=10
[org/gnome/shell/extensions/blur-my-shell/appfolder]
pipeline='pipeline_migrated_dynamic_blur'
[org/gnome/shell/extensions/blur-my-shell/applications]
pipeline='pipeline_default'
[org/gnome/shell/extensions/blur-my-shell/coverflow-alt-tab]
pipeline='pipeline_default'
[org/gnome/shell/extensions/blur-my-shell/dash-to-dock]
blur=false
pipeline='pipeline_default_rounded'
static-blur=true
style-dash-to-dock=0
[org/gnome/shell/extensions/blur-my-shell/lockscreen]
pipeline='pipeline_default'
[org/gnome/shell/extensions/blur-my-shell/overview]
pipeline='pipeline_default'
[org/gnome/shell/extensions/blur-my-shell/panel]
blur=false
corner-radius=0
pipeline='pipeline_default'
[org/gnome/shell/extensions/blur-my-shell/popup]
screenshot-corner-radius=36
[org/gnome/shell/extensions/blur-my-shell/screenshot]
pipeline='pipeline_default'
[org/gnome/shell/extensions/blur-my-shell/window-list]
pipeline='pipeline_migrated_dynamic_blur'
[org/gnome/shell/extensions/dash-in-panel]
button-margin=2
icon-size=20
panel-height=32
[org/gnome/shell/extensions/dash-to-dock]
background-opacity=0.25
dash-max-icon-size=42
dock-position='BOTTOM'
height-fraction=0.90000000000000002
preferred-monitor=-2
preview-size-scale=0.0
transparency-mode='DEFAULT'
[org/gnome/shell/extensions/ding]
check-x11wayland=true
[org/gnome/shell/extensions/just-perfection]
clock-menu-position=1
dash-icon-size=0
top-panel-position=1
[org/gnome/shell/extensions/tiling-assistant]
active-window-hint-color='rgb(211,70,21)'
overridden-settings={'org.gnome.mutter.edge-tiling': <@mb nothing>, 'org.gnome.mutter.keybindings.toggle-tiled-left': <@mb nothing>, 'org.gnome.mutter.keybindings.toggle-tiled-right': <@mb nothing>}
tiling-popup-all-workspace=true
[org/gnome/shell/extensions/user-theme]
name='Orchis-Grey-Dark-Compact'
[org/gnome/shell/world-clocks]
locations=@av []
[org/gnome/nautilus/preferences]
default-folder-viewer='icon-view'
migrated-gtk-settings=true
search-filter-time-type='last_modified'
